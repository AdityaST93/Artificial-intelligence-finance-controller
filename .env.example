# OpenRouter API key (free tier: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default model (free options)
OPENROUTER_MODEL=minimax/minimax-m3:free

# Razorpay test mode (optional, for live demo - not required for synthetic data)
# Get test keys at: https://dashboard.razorpay.com/app/keys (toggle "Test Mode")
# Without these, the RazorpayClient falls back to the deterministic synthetic data
# generated by `python -m data.generate`, so the app keeps working either way.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
